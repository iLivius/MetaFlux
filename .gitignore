# Snakemake internals — conda envs, metadata, locks, incomplete markers
.snakemake/

# Reference databases — downloaded/symlinked at run time, not part of the code
refdb/

# Python
__pycache__/
*.py[cod]

# R
.Rhistory
.RData

# OS / editor cruft
.DS_Store
*~
*.swp

# Internal staging notes (content folded into README.md)
README_notes.md

# Personal / customized run configs — only config.yaml (the template) is tracked
config/*.yaml
config/*.yml
!config/config.yaml
