# Snakemake internals — conda envs, metadata, locks, incomplete markers
.snakemake/

# Reference databases — downloaded/symlinked at run time, not part of the code.
# Anchored to the repo root so it does NOT also ignore workflow/scripts/refdb/
# (the reference-preparation scripts, which ARE code).
/refdb/

# Python
__pycache__/
*.py[cod]

# R
.Rhistory
.RData

# OS / editor cruft
.DS_Store
*~
*.swp

# Internal design/staging notes — archived under design-history/, kept private
# (historical rationale only; not part of the shipped repo or the docs)
design-history/

# Personal / customized run configs — only config.yaml (the template) is tracked
config/*.yaml
config/*.yml
!config/config.yaml
